{
  "name": "dsh-plugins",
  "version": "0.2.2",
  "private": true,
  "description": "DSH 控制台：插件管理（启停/删除/回收站/体检/日志/升级/中文简介）、会话操作、任务板、人设卡、记忆库、系统信息。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "plugin-manager",
    "dashboard"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
